# Cabeceras para Netlify y Cloudflare Pages (C15). Otros servidores: ver docs/PUBLICAR.md.
# La política de seguridad repite la de las páginas y suma lo que una meta no puede poner.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: https://power.larc.nasa.gov https://gibs.earthdata.nasa.gov https://tiles.openfreemap.org; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Cache-Control: public, max-age=0, must-revalidate

# Terceros con versión fija y fuentes: no cambian sin cambiar de archivo
/compartido/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Logo e íconos: cambian rara vez
/compartido/marca/*
  Cache-Control: public, max-age=604800

# Código y estilos propios: una hora, y se revalida
/*.js
  Cache-Control: public, max-age=3600, must-revalidate
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

# Datos: pueden regenerarse con procesar.py
/via-b/datos/*
  Cache-Control: public, max-age=3600, must-revalidate
/via-a/datos/*
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Content-Type: application/manifest+json
/docs/*.md
  Content-Type: text/markdown; charset=utf-8
